rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && request.auth.uid == "zyH3Sv6i5rVjWNpVRjw3bBHBVVM2"; }
    function member(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/driverAccounts/$(uid))
        && get(/databases/$(database)/documents/driverAccounts/$(uid)).data.enabled == true;
    }
    function divisionAllows(uid, sim) {
      let division = get(/databases/$(database)/documents/driverAccounts/$(uid)).data.get('division', 'both');
      return division == 'both' || division == sim;
    }
    function txt(x, n) { return x is string && x.size() <= n; }
    function num(x, lo, hi) { return x is number && x >= lo && x <= hi; }
    match /{document=**} { allow read, write: if owner(); }
    // Public recruitment: create only; owner-only read/update/delete.
    match /recruitmentApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasAll(['name','email','discord','sim','motivation','consent','status','created'])
        && request.resource.data.keys().hasOnly(['name','email','discord','sim','motivation','consent','status','created'])
        && txt(request.resource.data.name,80) && request.resource.data.name.size() >= 2
        && txt(request.resource.data.email,254) && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && txt(request.resource.data.discord,80)
        && request.resource.data.sim in ['ETS2','openOMSI','both']
        && txt(request.resource.data.motivation,1000) && request.resource.data.motivation.size() >= 5
        && request.resource.data.consent == true
        && request.resource.data.status == 'pending'
        && request.resource.data.created == request.time;
    }
    // Only enabled drivers can read the single maintenance notice; owner manages it.
    match /portalStatus/maintenance {
      allow get: if request.auth != null && member(request.auth.uid);
    }
    // Authenticated clock calibration: each enabled driver can access only their own probe.
    match /clockSync/{uid} {
      allow get: if member(uid);
      allow create, update: if member(uid)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.keys().hasAll(['at'])
        && request.resource.data.at == request.time;
    }
    match /portalStatus/announcements {
      allow get: if request.auth != null && member(request.auth.uid);
    }
    match /rulesReceipts/{uid} {
      allow get: if member(uid);
      allow create, update: if member(uid)
        && request.resource.data.keys().hasAll(['version','rules','at'])
        && request.resource.data.keys().hasOnly(['version','rules','at'])
        && request.resource.data.version == get(/databases/$(database)/documents/driverAccounts/$(uid)).data.get('rulesVersion', 'initial')
        && request.resource.data.rules == get(/databases/$(database)/documents/driverAccounts/$(uid)).data.rules
        && request.resource.data.at == request.time;
    }
    // Private read status for each enabled driver.
    match /announcementReads/{uid} {
      allow get: if member(uid);
      allow create, update: if member(uid)
        && request.resource.data.keys().hasAll(['ids','at'])
        && request.resource.data.keys().hasOnly(['ids','at'])
        && request.resource.data.ids is list
        && request.resource.data.ids.size() <= 30
        && request.resource.data.at == request.time;
    }
    match /driverAccounts/{uid} {
      allow get: if member(uid);
    }
    match /driverReports/{uid} {
      allow get: if member(uid) && (!exists(/databases/$(database)/documents/driverReports/$(uid)) || divisionAllows(uid, resource.data.sim));
      allow create, update: if member(uid)
        && divisionAllows(uid, request.resource.data.sim)
        && request.resource.data.keys().hasAll(['sim','vehicle','place','note','updated'])
        && request.resource.data.keys().hasOnly(['sim','vehicle','place','note','updated'])
        && request.resource.data.sim in ['ETS2','openOMSI']
        && txt(request.resource.data.vehicle,100) && txt(request.resource.data.place,150)
        && txt(request.resource.data.note,400)
        && request.resource.data.updated == request.time;
    }
    match /driverTelemetry/{uid} {
      allow get: if member(uid) && divisionAllows(uid, 'ETS2');
      allow create, update: if member(uid) && divisionAllows(uid, 'ETS2')
        && request.resource.data.keys().hasAll(['game','connected','x','z','speed','fuel','damage','truck','source','destination','cargo','updated'])
        && request.resource.data.keys().hasOnly(['game','connected','x','z','speed','fuel','damage','truck','source','destination','cargo','updated'])
        && request.resource.data.game == 'ETS2'
        && request.resource.data.connected is bool
        && num(request.resource.data.x,-10000000,10000000)
        && num(request.resource.data.z,-10000000,10000000)
        && num(request.resource.data.speed,0,500)
        && num(request.resource.data.fuel,0,20000)
        && num(request.resource.data.damage,0,100)
        && txt(request.resource.data.truck,100)
        && txt(request.resource.data.source,100)
        && txt(request.resource.data.destination,100)
        && txt(request.resource.data.cargo,150)
        && request.resource.data.updated == request.time;
    }
  }
}
